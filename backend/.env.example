APP_NAME=Ensight API
API_PREFIX=/api

# LLM reasoning — provider: openai (기본) | gemini
# OpenAI: platform.openai.com Secret key (sk-proj-...). sk-svcacct 는 Chat API에서 502(401) 발생.
OPENAI_API_KEY=
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# B: 로컬 XAI 샘플 (미설정 시 capstone/LLM_reasoning/text_reasoning_sample_data 자동 탐색)
# region_id N → load_N_xai_payloads.json (region_series_map.json으로 오버라이드 가능)
# XAI_SAMPLE_DATA_DIR=
# true 시 reasoning 후 추가 LLM 평가 (느림·비용 증가)
# ENSIGHT_REASONING_EVAL=false

DB_HOST=
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=
DB_SCHEMA=capstone
DB_SSLMODE=require
OPENAI_API_KEY=

ENSIGHT_REASONING_EVAL=false